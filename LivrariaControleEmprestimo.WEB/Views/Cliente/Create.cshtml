@model LivrariaControleEmprestimo.DATA.Models.Cliente

@{
    ViewData["Title"] = "Novo Cliente";
}

<h1 class="mt-4 mb-2 text-primary">
    <i class="fas fa-user-plus"></i> Novo Cliente
</h1>

<p class="lead">Preencha os campos abaixo para incluir um novo cliente.</p>

<div>
    <a class="btn btn-outline-primary mb-4" asp-action="Index">
        <i class="fas fa-arrow-left"></i> Voltar
    </a>
</div>

<div class="row">
    <div class="col-md">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Informações Pessoais -->
            <div class="card shadow-sm border-primary mb-4">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-id-card"></i> Informações Pessoais
                </div>
                <div class="card-body row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CliCpf" class="form-label"></label>
                        <input asp-for="CliCpf" class="form-control" />
                        <span asp-validation-for="CliCpf" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CliNome" class="form-label"></label>
                        <input asp-for="CliNome" class="form-control" />
                        <span asp-validation-for="CliNome" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Endereço -->
            <div class="card shadow-sm border-primary mb-4">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-map-marker-alt"></i> Endereço
                </div>
                <div class="card-body row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CliEndereco" class="form-label"></label>
                        <input asp-for="CliEndereco" class="form-control" />
                        <span asp-validation-for="CliEndereco" class="text-danger"></span>

                        <label asp-for="CliCidade" class="form-label mt-3"></label>
                        <input asp-for="CliCidade" class="form-control" />
                        <span asp-validation-for="CliCidade" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CliBairro" class="form-label"></label>
                        <input asp-for="CliBairro" class="form-control" />
                        <span asp-validation-for="CliBairro" class="text-danger"></span>

                        <label asp-for="CliNumero" class="form-label mt-3"></label>
                        <input asp-for="CliNumero" class="form-control" />
                        <span asp-validation-for="CliNumero" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Contato -->
            <div class="card shadow-sm border-primary mb-4">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-phone-alt"></i> Contato
                </div>
                <div class="card-body row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CliTelefoneCelular" class="form-label"></label>
                        <input asp-for="CliTelefoneCelular" class="form-control" />
                        <span asp-validation-for="CliTelefoneCelular" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CliTelefoneFixo" class="form-label"></label>
                        <input asp-for="CliTelefoneFixo" class="form-control" />
                        <span asp-validation-for="CliTelefoneFixo" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Botão -->
            <div class="form-group text-end">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-plus-circle"></i> Incluir Cliente
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}