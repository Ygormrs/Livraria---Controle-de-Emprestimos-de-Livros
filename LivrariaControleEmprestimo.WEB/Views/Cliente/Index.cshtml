@model IEnumerable<LivrariaControleEmprestimo.DATA.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<h1 class="mt-4 mb-3 text-primary">
    <i class="fas fa-users"></i> Clientes
</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">
        <i class="fas fa-user-plus"></i> Novo Cliente
    </a>
</p>

<div class="table-responsive">
    <table id="myTable" class="table table-bordered table-striped table-hover shadow-sm align-middle">
        <thead class="table-primary">
            <tr>
                <th>@Html.DisplayNameFor(model => model.CliCpf)</th>
                <th>@Html.DisplayNameFor(model => model.CliNome)</th>
                <th>@Html.DisplayNameFor(model => model.CliTelefoneCelular)</th>
                <th>@Html.DisplayNameFor(model => model.CliTelefoneFixo)</th>
                <th class="text-center">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.CliCpf)</td>
                    <td>@Html.DisplayFor(modelItem => item.CliNome)</td>
                    <td>@Html.DisplayFor(modelItem => item.CliTelefoneCelular)</td>
                    <td>@Html.DisplayFor(modelItem => item.CliTelefoneFixo)</td>
                    <td class="text-center">
                        <a asp-action="Edit" class="btn btn-sm btn-success" asp-route-id="@item.Id">
                            <i class="fas fa-edit"></i> Alterar
                        </a>
                        <a asp-action="Details" class="btn btn-sm btn-primary" asp-route-id="@item.Id">
                            <i class="fas fa-info-circle"></i> Detalhes
                        </a>
                        <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#DeleteModal-@item.Id">
                            <i class="fas fa-trash-alt"></i> Excluir
                        </button>

                        <!-- Modal de exclusão -->
                        <div class="modal fade" id="DeleteModal-@item.Id" tabindex="-1" aria-labelledby="DeleteModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header bg-danger text-white">
                                        <h5 class="modal-title" id="DeleteModalLabel">
                                            <i class="fas fa-exclamation-triangle"></i> Confirmar Exclusão
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                    </div>
                                    <div class="modal-body">
                                        Deseja realmente excluir o cliente <strong>@item.CliNome</strong>?
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                        <a asp-action="Delete" class="btn btn-danger" asp-route-id="@item.Id">Confirmar</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        let table = new DataTable('#myTable', {
            language: {
                url: "//cdn.datatables.net/plug-ins/1.11.3/i18n/pt_br.json"
            }
        });
    </script>
}
