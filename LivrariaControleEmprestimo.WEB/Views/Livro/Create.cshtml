@model LivrariaControleEmprestimo.DATA.Models.Livro

@{
    ViewData["Title"] = "Adicionar Livro";
}

<h1 class="mt-4 mb-2 text-primary">
    <i class="fas fa-book-medical"></i> Adicionar Livro
</h1>

<p class="lead">Adicione um novo livro no sistema preenchendo os campos abaixo.</p>

<div>
    <a class="btn btn-outline-primary mb-4" asp-action="Index">
        <i class="fas fa-arrow-left"></i> Voltar
    </a>
</div>

<div class="row">
    <div class="col-md">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="card shadow-sm border-primary mb-4">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-info-circle"></i> Informações do Livro
                </div>
                <div class="card-body row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="LivroNome" class="form-label"></label>
                        <input asp-for="LivroNome" class="form-control" />
                        <span asp-validation-for="LivroNome" class="text-danger"></span>

                        <label asp-for="LivroAutor" class="form-label mt-3"></label>
                        <input asp-for="LivroAutor" class="form-control" />
                        <span asp-validation-for="LivroAutor" class="text-danger"></span>

                        <label asp-for="LivroEditora" class="form-label mt-3"></label>
                        <input asp-for="LivroEditora" class="form-control" />
                        <span asp-validation-for="LivroEditora" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="LivroAnoPublicacao" class="form-label"></label>
                        <input asp-for="LivroAnoPublicacao" class="form-control" />
                        <span asp-validation-for="LivroAnoPublicacao" class="text-danger"></span>

                        <label asp-for="LivroEdicao" class="form-label mt-3"></label>
                        <input asp-for="LivroEdicao" class="form-control" />
                        <span asp-validation-for="LivroEdicao" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group text-end">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-plus-circle"></i> Adicionar
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
